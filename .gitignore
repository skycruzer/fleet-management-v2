storybook-static/
tsconfig.tsbuildinfo
next-env.d.ts

# Test outputs
test-results/
playwright-report/
test-screenshots/
screenshots/

# Backups
*.backup
node_modules_old/

# Environment files — broad pattern so stray duplicates (e.g. ".env.production 2.local"
# from a vercel env pull) can never be committed; whitelist examples explicitly
.env*
!.env.example
!.env.test.local.example

# Vercel
.vercel/

# Debug logs
firebase-debug.log

# Supabase CLI scratch state (per-machine, churns on CLI version changes)
supabase/.temp/

# Local assistant journal/notes — never project source
knowledge/

# IDE / tooling
.worktrees/
.playwright-mcp/
.playwright-cli/
.kombai/
.serena/

# Third-party MCP server cloned inside the repo root. Not our source; it ships
# its own Bun toolchain, whose global type declarations were being pulled into
# our TypeScript program and breaking `npm run type-check`.
claude-talk-to-figma-mcp/

# Claude Code session artifacts
.claude/worktrees/
.claude/scheduled_tasks.lock
.vercel

# EBT migration working files (raw pg_dump scratch — data is captured in supabase/migrations/)
scratch/

# Cloud-sync conflict copies. The repo lives in a synced folder, which spawns
# "<name> 2.ext" duplicates (18 of these had been committed, plus copies under
# .git/ that silently break fetch). Keep them out of the index; clean the ones
# under .git/refs/ by hand if origin/* ever looks stale.
*[ ][0-9].*
*[ ][0-9][0-9].*
*[ ][0-9]
*[ ][0-9][0-9]

# Vendored MCP server dropped into the repo root. It is a self-contained Bun
# project with its own tests and toolchain; leaving it in scope pulled Bun's
# global type definitions into `tsc` and produced 363 errors plus two spurious
# ones in lib/supabase/*, which made `npm run validate` impossible to pass.
# Also excluded in tsconfig.json.
claude-talk-to-figma-mcp/
